{
  "manifest_version": 3,
  "name": "ScanLate v3",
  "description": "Real-time local manga translator using OCR-only layout and CSS Overlays.",
  "version": "3.0.0",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8745/*",
    "http://127.0.0.1:8745/*",
    "<all_urls>"
  ],
  "options_page": "settings/settings.html",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
