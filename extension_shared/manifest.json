{
  "manifest_version": 3,
  "name": "ScanLate v3 (Shared Edition)",
  "description": "Scan and translate manga directly in your browser. (Shared Server Edition)",
  "version": "3.0.1",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8745/*",
    "http://127.0.0.1:8745/*",
    "<all_urls>"
  ],
  "options_page": "settings/settings.html",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
